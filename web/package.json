{
    "name": "@volcanoplot/web",
    "version": "0.0.1",
    "type": "module",
    "description": "VolcanoPlot WebGPU front-end — WASM engine + op-stream interpreter",
    "exports": {
        ".": {
            "types": "./dist/volcano.d.ts",
            "import": "./dist/bundle.mjs"
        }
    },
    "files": [
        "dist/bundle.mjs",
        "dist/volcanoplot.js",
        "dist/volcanoplot.wasm",
        "dist/volcanoplot.data",
        "dist/*.d.ts"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node build.mjs",
        "test": "vitest run",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.6.4",
        "@webgpu/types": "^0.1.40",
        "esbuild": "^0.28.2",
        "typescript": "^5.5.0",
        "vitest": "^2.0.0"
    }
}
